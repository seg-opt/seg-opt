# Your PRIVATE SSH key contents (the whole -----BEGIN ... END----- block).
SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
...
-----END OPENSSH PRIVATE KEY-----"

# Your cluster username.
USERNAME="" # e.g. jan-kowalski

# Cluster login node address.
CLUSTER_ADDRESS="" # e.g. eagle.man.poznan.pl

# ID of service.
SERVICE_ID="" # e.g. pl1234-01

# Immutable SIF path on Eagle, relative to ~/<SERVICE_ID> or absolute.
CONTAINER_IMAGE="" # e.g. project_data/containers/seg-opt/images/v0.1.0/seg-opt-v0.1.0.sif

# Paths relative to ~/<SERVICE_ID>, or absolute Eagle paths.
DATA_PATH="project_data/datasets"
RUNS_PATH="project_data/runs"
CACHE_PATH="project_data/cache/seg-opt"

# Set to 1 only when integration tests should allocate an H100 smoke job.
RUN_CONTAINER_GPU_TEST="0"